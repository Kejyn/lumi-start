      m_Items: []
  - m_Id: 1402896389
    m_Localized: Utilisez une commande de la manette. Annuler pour quitter (10 secondes).
    m_Metadata:
      m_Items: []
  - m_Id: 1402896390
    m_Localized: Appuyez sur une touche. Annuler pour quitter (10 secondes).
    m_Metadata:
      m_Items: []
  - m_Id: 1402896391
    m_Localized: Utilisez une commande de la souris. Annuler pour quitter (10 secondes).
    m_Metadata:
      m_Items: []
  - m_Id: 1402896392
    m_Localized: "Cette commande est r\xE9serv\xE9e \xE0 la pause ou aux sauvegardes.
      L'affectation pr\xE9c\xE9dente est conserv\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1402896393
    m_Localized: "Les commandes enregistr\xE9es sont illisibles. Les commandes actuelles
      sont conserv\xE9es."
