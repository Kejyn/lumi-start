  - m_Id: 1398702129
    m_Localized: Controls
    m_Metadata:
      m_Items: []
  - m_Id: 1398702130
    m_Localized: "Game title\n\nKejyn \u2014 Developer\n\nDesign\nA simple foundation
      for your next game.\n\nGameplay\nReplace this demo with your own mechanics.\n\nArt\nAdd
      your own environments and characters.\n\nAudio\nReplace the demonstration music
      and sounds.\n\nProduction\nBuilt with lumi-core and lumi-start.\n\nTesting\nThank
      you to everyone who helps test the game.\n\nSpecial thanks\nTo the people who
      support your project.\n\nEnd of demonstration credits"
    m_Metadata:
      m_Items: []
